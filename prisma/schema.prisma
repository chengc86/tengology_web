generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts connection URLs here — the CLI reads them from
// prisma.config.ts, and the runtime client gets them via the adapter in
// src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

// ─── Auth ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  image         String?
  role          String    @default("CUSTOMER")
  marketingOptIn Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  addresses   Address[]
  orders      Order[]
  cartItems   CartItem[]
  wishlist    WishlistItem[]
  reviews     ProductReview[]
  redemptions DiscountRedemption[]
  designs     SavedDesign[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Address ────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  firstName String
  lastName  String
  phone     String?
  line1     String
  line2     String?
  city      String
  county    String?
  postcode  String
  country   String  @default("GB")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Products ───────────────────────────────────────

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  shortDescription  String?
  fullDescription   String?
  category          String   @default("OTHER")
  subcategory       String?
  materials         String   @default("") // comma-separated
  price             Float
  compareAtPrice    Float?
  stockCount        Int      @default(0)
  lowStockThreshold Int      @default(3)
  weight            Float?
  isPublished       Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  collection        String?
  intention         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images        ProductImage[]
  tags          ProductTag[]
  seo           ProductSeo?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  etsySync      EtsySync?
  squareSync    SquareSync?
  socialDrafts  SocialDraft[]
  wishlistedBy  WishlistItem[]
  reviews       ProductReview[]

  @@index([isPublished, category])
  @@index([isPublished, isFeatured])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  url          String
  altText      String?
  sortOrder    Int     @default(0)
  isPrimary    Boolean @default(false)
  cloudinaryId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductSeo {
  id              String  @id @default(cuid())
  productId       String  @unique
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Cart ───────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([sessionId])
}

// ─── Orders ─────────────────────────────────────────

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  userId      String?
  guestEmail  String?
  email       String   @default("")
  phone       String?

  // Lifecycle. status is the headline state shown to customers;
  // paymentStatus and fulfillmentStatus track the two independent workflows.
  status            String @default("PENDING")
  paymentStatus     String @default("UNPAID")
  fulfillmentStatus String @default("UNFULFILLED")

  currency       String @default("GBP")
  subtotal       Float
  discountAmount Float  @default(0)
  shippingCost   Float  @default(0)
  taxAmount      Float  @default(0)
  total          Float
  refundedAmount Float  @default(0)

  discountCode       String?
  shippingMethodId   String?
  shippingMethodName String?

  shippingAddress String? // JSON string
  billingAddress  String? // JSON string
  notes           String? // customer-supplied delivery notes
  adminNotes      String? // internal, never shown to the customer
  giftMessage     String?

  // Guest orders are looked up with this unguessable token instead of a login.
  guestToken String? @unique

  squarePaymentId String?
  squareOrderId   String?
  squareReceiptUrl String?
  etsyReceiptId   String?

  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?

  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  events   OrderEvent[]
  reviews  ProductReview[]
  redemptions DiscountRedemption[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String
  productTitleSnapshot String
  productSlugSnapshot  String?
  productImageSnapshot String?
  quantity             Int
  unitPrice            Float
  totalPrice           Float
  quantityRefunded     Int     @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Payments & Refunds ─────────────────────────────

model Payment {
  id              String  @id @default(cuid())
  orderId         String
  provider        String  @default("SQUARE")
  squarePaymentId String? @unique
  squareOrderId   String?
  idempotencyKey  String  @unique

  status   String // PENDING, APPROVED, COMPLETED, CANCELED, FAILED
  amount   Float
  currency String @default("GBP")

  cardBrand    String?
  last4        String?
  walletType   String? // APPLE_PAY, GOOGLE_PAY, CASH_APP…
  receiptUrl   String?
  errorCode    String?
  errorMessage String?
  raw          String? // JSON snapshot of the provider response

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id             String  @id @default(cuid())
  orderId        String
  paymentId      String?
  squareRefundId String? @unique
  idempotencyKey String  @unique

  amount   Float
  currency String @default("GBP")
  reason   String?
  status   String @default("PENDING") // PENDING, COMPLETED, REJECTED, FAILED
  restocked Boolean @default(false)
  errorMessage String?
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
}

// ─── Order timeline ─────────────────────────────────

model OrderEvent {
  id      String  @id @default(cuid())
  orderId String
  type    String // CREATED, PAYMENT_SUCCEEDED, PAYMENT_FAILED, STATUS_CHANGED, SHIPPED, DELIVERED, CANCELLED, REFUNDED, NOTE, EMAIL_SENT
  message String
  meta    String? // JSON
  actor   String? // user id, "system", "customer", "square-webhook"
  isCustomerVisible Boolean @default(true)

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── Discounts ──────────────────────────────────────

model DiscountCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?
  type        String  @default("PERCENT") // PERCENT, FIXED, FREE_SHIPPING
  value       Float   @default(0)

  minSubtotal      Float?
  maxRedemptions   Int?
  perCustomerLimit Int?
  timesRedeemed    Int     @default(0)
  isActive         Boolean @default(true)

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  redemptions DiscountRedemption[]
}

model DiscountRedemption {
  id             String @id @default(cuid())
  discountCodeId String
  orderId        String
  userId         String?
  email          String
  amount         Float

  createdAt DateTime @default(now())

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@unique([discountCodeId, orderId])
  @@index([email])
}

// ─── Wishlist ───────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─── Reviews ────────────────────────────────────────

model ProductReview {
  id        String  @id @default(cuid())
  productId String
  userId    String?
  orderId   String?

  authorName String
  rating     Int
  title      String?
  body       String?

  isApproved         Boolean @default(false)
  isVerifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, isApproved])
}

// ─── Transactional email log ────────────────────────

model EmailLog {
  id         String  @id @default(cuid())
  to         String
  subject    String
  template   String
  orderId    String?
  status     String  @default("SENT") // SENT, FAILED, SKIPPED
  providerId String?
  error      String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─── Store settings (key/value) ─────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Inventory ──────────────────────────────────────

model InventoryLog {
  id             String   @id @default(cuid())
  productId      String
  changeType     String   // SALE, RESTOCK, ADJUSTMENT, ETSY_SYNC, SQUARE_SYNC, MANUAL
  quantityBefore Int
  quantityAfter  Int
  delta          Int
  note           String?
  triggeredBy    String?
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Sync ───────────────────────────────────────────

model EtsySync {
  id            String    @id @default(cuid())
  productId     String    @unique
  etsyListingId String    @unique
  lastSyncedAt  DateTime?
  syncStatus    String    @default("PENDING")
  lastError     String?
  etsyUrl       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SquareSync {
  id                  String    @id @default(cuid())
  productId           String    @unique
  squareCatalogItemId String    @unique
  squareVariationId   String?
  lastSyncedAt        DateTime?
  syncStatus          String    @default("PENDING")
  lastError           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Shipping ───────────────────────────────────────

model ShippingZone {
  id            String @id @default(cuid())
  name          String
  baseRate      Float
  freeThreshold Float?
}

model ShippingMethod {
  id            String  @id @default(cuid())
  name          String
  description   String?
  carrier       String?
  price         Float   @default(0)
  freeThreshold Float? // subtotal at or above which this method is free
  minDays       Int?
  maxDays       Int?
  countries     String  @default("GB") // comma-separated ISO codes, or "*" for anywhere
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Site Settings ──────────────────────────────────

model Announcement {
  id        String    @id @default(cuid())
  message   String
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
}

// ─── Jewelry designer ───────────────────────────────

enum JewelryKind {
  bracelet
  necklace
  ring
  earrings
}

model SavedDesign {
  id           String      @id @default(cuid())
  userId       String?
  kind         JewelryKind
  state        Json // validated against DesignStateSchema on read
  thumbnailUrl String?
  shareSlug    String      @unique @default(cuid())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Purchased bead strands. Unit cost per bead feeds designer retail pricing.
model InventoryLot {
  id              String  @id @default(cuid())
  sku             String  @unique
  catalogSlug     String
  catalogName     String
  sourceImageFile String?
  labelText       String?
  productName     String
  material        String
  shape           String
  // Money and physical quantities are exact: unit cost per bead is a division
  // of a purchase price by beads-per-strand, and float drift compounds there.
  sizeMm          Decimal? @db.Decimal(6, 2)

  purchaseQuantity          Int     @default(1)
  unitPurchasePriceCny      Decimal @db.Decimal(10, 2)
  beadsPerStrand            Int
  estimatedWeightGPerStrand Decimal @db.Decimal(10, 2)
  shippingRateCnyPerKg      Decimal @default(80) @db.Decimal(10, 2)
  shippingCnyPerStrand      Decimal @db.Decimal(10, 2)
  totalCostCnyPerStrand     Decimal @db.Decimal(10, 2)
  unitCostCnyPerBead        Decimal @db.Decimal(10, 2)

  priceConfidence  String @default("confirmed")
  countConfidence  String @default("estimated")
  weightConfidence String @default("estimated")

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([material])
  @@index([productName])
}

// ─── Social Media ───────────────────────────────────

model SocialAccount {
  id           String   @id @default(cuid())
  platform     String   // INSTAGRAM, FACEBOOK, TIKTOK, X, PINTEREST
  accountName  String
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  isConnected  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts SocialPost[]
}

model SocialDraft {
  id          String   @id @default(cuid())
  date        DateTime // the date this draft is for
  platform    String   // INSTAGRAM, FACEBOOK, TIKTOK, X, PINTEREST, ALL
  caption     String
  hashtags    String   @default("") // comma-separated
  imageUrl    String?  // product image from site
  videoUrl    String?  // generated video URL
  videoJobId  String?  // MiniMax job ID for tracking
  productId   String?  // linked product
  theme       String?  // e.g. "product spotlight", "behind the scenes", "seasonal"
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, POSTED
  isSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
}

model SocialPost {
  id               String   @id @default(cuid())
  draftId          String?
  socialAccountId  String
  platform         String
  caption          String
  hashtags         String   @default("")
  imageUrl         String?
  videoUrl         String?
  platformPostId   String?  // ID returned by the platform after posting
  platformPostUrl  String?  // URL to the live post
  status           String   @default("PENDING") // PENDING, POSTED, FAILED
  error            String?
  scheduledFor     DateTime?
  postedAt         DateTime?
  createdAt        DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id])
}

model SocialSchedule {
  id        String @id @default(cuid())
  platform  String @unique // INSTAGRAM, FACEBOOK, TIKTOK, X, PINTEREST
  postTime  String // HH:MM in 24h format (UK time)
  isActive  Boolean @default(true)
  timezone  String  @default("Europe/London")
}
