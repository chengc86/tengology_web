# ─── Database (Neon Postgres) ───────────────────────
# DATABASE_URL is the POOLED endpoint (hostname contains "-pooler") and is what
# the app uses at runtime. DIRECT_URL is the same database without the pooler;
# Prisma Migrate needs it because the pooler does not support DDL sessions.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ───────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3001"

# ─── Site ───────────────────────────────────────────
# Used to build order links inside transactional emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ─── Optional integrations ──────────────────────────
# The app runs without these; the related features degrade gracefully.

# AI listing assistant + designer stylist
ANTHROPIC_API_KEY=""

# Product image hosting
CLOUDINARY_URL=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Transactional email — without a key, emails are logged as SKIPPED and
# orders still complete.
RESEND_API_KEY=""
EMAIL_FROM="Tengology <orders@tengology.com>"
ADMIN_EMAIL="hello@tengology.com"          # where new-order alerts are sent

# Square payments — checkout falls back to unpaid orders when these are
# absent. Empty strings count as absent (do not leave LOCATION_ID blank
# on the public key if you filled the server one — either set both to the
# same id, or leave the public key unset).
#
# Setup: docs/square-checkout.md
# Credentials: https://developer.squareup.com/apps  → your app → Sandbox
# (or Production). The location currency must be GBP.
#
# Required to take cards:
SQUARE_ACCESS_TOKEN=""                     # Sandbox/Production Access token (server only)
SQUARE_ENVIRONMENT="sandbox"               # "sandbox" | "production" — must match the keys
SQUARE_LOCATION_ID=""                      # Locations tab, same env as the token
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""       # Sandbox/Production Application ID (safe to expose)
NEXT_PUBLIC_SQUARE_LOCATION_ID=""          # optional; defaults to SQUARE_LOCATION_ID

# Square webhooks keep payment/refund state in sync when money moves outside
# checkout (dashboard refunds, delayed capture, disputes). Subscribe to
# payment.created, payment.updated, refund.created, refund.updated.
# The URL must exactly match the one registered in the Square dashboard
# or signature checks will fail. After changing NEXT_PUBLIC_* vars, restart
# (dev) or rebuild (production) so the card form sees them.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL="http://localhost:3001/api/webhooks/square"
